#!/usr/bin/env bash
# Focus Universal Uninstaller Dispatcher
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OS_NAME="$(uname -s 2>/dev/null || echo "Windows")"

case "${OS_NAME}" in
    Darwin*)
        exec "${SCRIPT_DIR}/mac/uninstall" "$@"
        ;;
    Linux*)
        exec "${SCRIPT_DIR}/linux/uninstall" "$@"
        ;;
    *)
        echo "Detected OS: ${OS_NAME}"
        if [[ -x "${SCRIPT_DIR}/linux/uninstall" ]]; then
            exec "${SCRIPT_DIR}/linux/uninstall" "$@"
        else
            echo "Unsupported platform: ${OS_NAME}" >&2
            exit 1
        fi
        ;;
esac
