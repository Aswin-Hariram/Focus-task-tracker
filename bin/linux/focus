#!/usr/bin/env bash
# Focus Productivity Tracker - Linux Service & CLI Controller
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
PROJECT_DIR="$(cd "${BIN_DIR}/.." && pwd)"

JAR_FILE="${BIN_DIR}/focus.jar"
if [[ ! -f "${JAR_FILE}" ]]; then
    JAR_FILE="${PROJECT_DIR}/productivity-app/target/productivity-app-1.0.0-SNAPSHOT.jar"
fi

PID_FILE="${PROJECT_DIR}/storage/focus.pid"
LOG_DIR="${PROJECT_DIR}/storage/logs"
LOG_FILE="${LOG_DIR}/focus.log"

SERVER_PORT="${SERVER_PORT:-8484}"
EMBEDDED_POSTGRES_PORT="${EMBEDDED_POSTGRES_PORT:-5433}"
JVM_OPTS="${JVM_OPTS:--Xms256m -Xmx1024m}"

ensure_java() {
    if ! command -v java >/dev/null 2>&1; then
        echo "Error: Java is not installed or not in PATH. Java 17+ is required." >&2
        exit 1
    fi
    local java_version
    java_version=$(java -version 2>&1 | awk -F '"' '/version/ {print $2}' | cut -d'.' -f1)
    if [[ -n "${java_version}" && "${java_version}" -lt 17 ]]; then
        echo "Error: Java 17+ required (found Java ${java_version})." >&2
        exit 1
    fi
}

ensure_jar() {
    if [[ ! -f "${JAR_FILE}" ]]; then
        echo "Error: Application JAR not found." >&2
        echo "Looked for:" >&2
        echo "  - ${BIN_DIR}/focus.jar" >&2
        echo "  - ${PROJECT_DIR}/productivity-app/target/productivity-app-1.0.0-SNAPSHOT.jar" >&2
        echo "Run 'mvn package -DskipTests' first to compile the application." >&2
        exit 1
    fi
}

is_running() {
    if [[ -f "${PID_FILE}" ]]; then
        local pid
        pid=$(cat "${PID_FILE}" 2>/dev/null || true)
        if [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

do_run() {
    ensure_java
    ensure_jar
    mkdir -p "${PROJECT_DIR}/storage" "${LOG_DIR}"
    cd "${PROJECT_DIR}"
    echo "Starting Focus Personal Productivity Tracker in foreground..."
    echo "Web UI: http://localhost:${SERVER_PORT}"
    exec java ${JVM_OPTS} \
        -Dserver.port="${SERVER_PORT}" \
        -DEMBEDDED_POSTGRES_PORT="${EMBEDDED_POSTGRES_PORT}" \
        -jar "${JAR_FILE}" "$@"
}

do_start() {
    ensure_java
    ensure_jar
    mkdir -p "${PROJECT_DIR}/storage" "${LOG_DIR}"

    if is_running; then
        local pid
        pid=$(cat "${PID_FILE}")
        echo "Focus is already running (PID: ${pid})."
        echo "Web UI: http://localhost:${SERVER_PORT}"
        exit 0
    fi

    cd "${PROJECT_DIR}"
    echo "Starting Focus background service on port ${SERVER_PORT}..."
    nohup java ${JVM_OPTS} \
        -Dserver.port="${SERVER_PORT}" \
        -DEMBEDDED_POSTGRES_PORT="${EMBEDDED_POSTGRES_PORT}" \
        -jar "${JAR_FILE}" > "${LOG_FILE}" 2>&1 &
    local new_pid=$!
    echo "${new_pid}" > "${PID_FILE}"

    local waited=0
    while [[ ${waited} -lt 15 ]]; do
        if ! kill -0 "${new_pid}" 2>/dev/null; then
            echo "Failed to start! Check logs at ${LOG_FILE}:"
            tail -n 25 "${LOG_FILE}"
            rm -f "${PID_FILE}"
            exit 1
        fi
        if grep -q "Started ProductivityApplication" "${LOG_FILE}" 2>/dev/null; then
            echo "Focus started successfully (PID: ${new_pid})."
            echo "Web UI: http://localhost:${SERVER_PORT}"
            echo "Logs:   ${LOG_FILE}"
            exit 0
        fi
        sleep 1
        waited=$((waited + 1))
    done

    echo "Focus process started (PID: ${new_pid}). Check logs at ${LOG_FILE}."
}

do_stop() {
    if ! is_running; then
        echo "Focus is not running."
        rm -f "${PID_FILE}"
        return 0
    fi

    local pid
    pid=$(cat "${PID_FILE}")
    echo "Stopping Focus (PID: ${pid})..."
    kill -15 "${pid}" 2>/dev/null || true

    local waited=0
    while [[ ${waited} -lt 20 ]]; do
        if ! kill -0 "${pid}" 2>/dev/null; then
            echo "Focus stopped cleanly."
            rm -f "${PID_FILE}"
            return 0
        fi
        sleep 1
        waited=$((waited + 1))
    done

    echo "Focus did not shut down gracefully within 20s. Forcing SIGKILL..."
    kill -9 "${pid}" 2>/dev/null || true
    rm -f "${PID_FILE}"
    echo "Focus terminated."
}

do_restart() {
    do_stop
    sleep 2
    do_start
}

do_status() {
    if is_running; then
        local pid
        pid=$(cat "${PID_FILE}")
        echo "● Focus service is RUNNING"
        echo "  PID:     ${pid}"
        echo "  Web UI:  http://localhost:${SERVER_PORT}"
        echo "  DB Port: ${EMBEDDED_POSTGRES_PORT}"
        echo "  JAR:     ${JAR_FILE}"
        echo "  Logs:    ${LOG_FILE}"
    else
        echo "○ Focus service is STOPPED"
        if [[ -f "${PID_FILE}" ]]; then
            echo "  (Stale PID file found: ${PID_FILE})"
        fi
    fi
}

do_logs() {
    if [[ ! -f "${LOG_FILE}" ]]; then
        echo "Log file does not exist yet: ${LOG_FILE}"
        exit 1
    fi
    exec tail -f "${LOG_FILE}"
}

usage() {
    echo "Focus Personal Productivity Tracker (Linux)"
    echo "Usage: $0 {run|start|stop|restart|status|logs|update|uninstall}"
    echo ""
    echo "Commands:"
    echo "  run        Run in foreground (console mode)"
    echo "  start      Start as background daemon"
    echo "  stop       Stop the running daemon"
    echo "  restart    Restart the daemon"
    echo "  status     Show service health and PID"
    echo "  logs       Tail application logs"
    echo "  update     Update Focus to latest version or from source/file"
    echo "  uninstall  Uninstall Focus services and application"
    exit 1
}

case "${1:-}" in
    run)       shift; do_run "$@" ;;
    start)     do_start ;;
    stop)      do_stop ;;
    restart)   do_restart ;;
    status)    do_status ;;
    logs)      do_logs ;;
    update)    shift; exec "${SCRIPT_DIR}/update" "$@" ;;
    uninstall) shift; exec "${SCRIPT_DIR}/uninstall" "$@" ;;
    *)         usage ;;
esac
